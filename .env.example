# Server Environment Configuration
PORT=3001
NODE_ENV=development

# Supabase Cloud Database Connection (Optional: local file persistence used if unset)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# AI Provider API Keys (Optional: when unset, StudyScout uses its built-in Intelligent Reasoning Engine)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=

# Search Provider API Keys (Optional: when unset, StudyScout uses live Wikipedia REST API, CrossRef API & curated research index)
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Document Processing Limits
MAX_UPLOAD_SIZE_MB=15
ALLOWED_EXTENSIONS=pdf,docx,txt,md
